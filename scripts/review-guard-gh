#!/bin/sh
# See review-guard-git. GitHub review submission is the only permitted remote
# mutation during a direct review task.
if [ "${OPTIO_REVIEW_GUARD_ACTIVE:-}" = "1" ]; then
  allowed=false
  if [ "${1:-}" = "pr" ] && {
    [ "${2:-}" = "diff" ] || [ "${2:-}" = "view" ] || [ "${2:-}" = "review" ] || [ "${2:-}" = "comment" ];
  }; then
    allowed=true
  elif [ "${1:-}" = "api" ] && {
    [ "${2:-}" = "user" ] || case "${2:-}" in repos/*) true ;; *) false ;; esac;
  }; then
    # Reviewers may identify themselves or read repository content. Keep API
    # access read-only: only response-formatting flags are safe; fields and
    # methods would permit writes because gh switches to POST for fields.
    shift 2
    allowed=true
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --paginate|--slurp) shift ;;
        --jq) [ "$#" -ge 2 ] || { allowed=false; break; }; shift 2 ;;
        *) allowed=false; break ;;
      esac
    done
  fi
  if [ "$allowed" != true ]; then
    echo "Optio review guard blocks this gh operation; only review PR commands and read-only gh api user/repos lookups are allowed." >&2
    exit 126
  fi
fi
exec /opt/optio/gh-real "$@"
